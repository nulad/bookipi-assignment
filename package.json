{
  "name": "bookipi-assignment",
  "version": "1.0.0",
  "description": "Take-Home Project: High-Throughput Flash Sale System",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "apps/*/src"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "setup": "npm install --workspaces",
    "dev:api": "npm run dev --workspace=flash-sale-api",
    "dev:web": "npm --prefix apps/web run dev",
    "start:api": "npm run start --workspace=flash-sale-api",
    "build:web": "npm --prefix apps/web run build",
    "db:schema:api": "npm run db:schema --workspace=flash-sale-api",
    "sale:init:api": "npm run sale:init --workspace=flash-sale-api",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=flash-sale-api",
    "stress:purchase-burst": "k6 run tests/stress/purchase-burst.js",
    "stress:purchase-repeated-users": "k6 run tests/stress/purchase-repeated-users.js",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "infra:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "vitest": "^2.1.8",
    "supertest": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nulad/bookipi-assignment.git"
  },
  "author": "Nulad Pambudi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nulad/bookipi-assignment/issues"
  },
  "homepage": "https://github.com/nulad/bookipi-assignment#readme"
}
