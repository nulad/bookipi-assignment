PORT=3000
POSTGRES_URL=postgresql://bookipi:bookipi123@localhost:5433/bookipi
POSTGRES_TEST_URL=postgresql://bookipi:bookipi123@localhost:5433/bookipi_test
REDIS_URL=redis://localhost:6379
CORS_ALLOWED_ORIGIN=*
SALE_PRODUCT_NAME=Flash Sale Item
# Required reviewer step: replace both placeholder timestamps in your local .env before
# running docker compose up, npm run sale:init:api, or any stress test.
# The API reads these at process start. If you change them later, restart the API and
# rerun the sale init step so Redis stock and the active sale cache are reseeded.
SALE_START_TIME=2099-01-01T10:00:00.000Z
SALE_END_TIME=2099-01-01T10:10:00.000Z
SALE_INITIAL_STOCK=100

# Optional k6 stress-test overrides
# BASE_URL=http://127.0.0.1:3000
# PURCHASE_PATH=/purchase
# SALE_STATUS_PATH=/sale-status
# BURST_RATE=250
# BURST_DURATION=15s
# REPEATED_RATE=250
# REPEATED_DURATION=15s
# REPEATED_USER_POOL_SIZE=25
# PRE_ALLOCATED_VUS=200
# MAX_VUS=1000
# EXPECTED_MAX_P95_MS=750
# EXPECTED_MAX_P99_MS=1500
