# Placeholder sale window.
# Update both values in your local .env before running sale:init:api so the current time
# falls inside the sale window you want to test.
SALE_START_TIME=2099-01-01T10:00:00.000Z
SALE_END_TIME=2099-01-01T10:10:00.000Z
SALE_INITIAL_STOCK=100

