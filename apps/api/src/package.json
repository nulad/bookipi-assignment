{
  "name": "flash-sale-api",
  "version": "1.0.0",
  "description": "Flash sale API backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:schema": "node scripts/apply-schema.js",
    "sale:init": "node scripts/init-sale.js",
    "purchase:reconcile": "node scripts/reconcile-purchase-persistence-failures.js",
    "wait:deps": "node scripts/wait-for-dependencies.js",
    "start:container": "npm run wait:deps && npm run db:schema && npm run sale:init && npm run start",
    "init:container": "npm run wait:deps && npm run db:schema && npm run sale:init",
    "test:container": "npm run wait:deps && npm run test",
    "test": "vitest run --config vitest.config.js --root ..",
    "test:watch": "vitest --config vitest.config.js --root .. --watch"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "vitest": "^2.1.8",
    "supertest": "^7.0.0"
  }
}
